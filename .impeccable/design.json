      "kind": "chip",
      "refersTo": "chip",
      "description": "Form checkbox as a chip; violet when checked, blue on hover/focus.",
      "html": "<div class=\"ds-light\"><label class=\"ds-chip\"><input type=\"checkbox\" checked><span>Repairs</span></label> <label class=\"ds-chip\"><input type=\"checkbox\"><span>Drywall installation</span></label></div>",
