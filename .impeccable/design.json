      "html": "<div class=\"ds-dark\"><div class=\"ds-stairs\"><figure></figure><figure></figure><figure></figure><figure></figure><figure></figure></div></div>",
      "css": ":host{--ground:#1d1932;--ground-2:#262042;--compound:#f1efe9;--ink:#1d1932;--ink-soft:#4a4466;--on-dark:#efecf7;--on-dark-soft:#bdb6d6;--violet:#6d2ee6;--violet-hi:#a678ff;--form-accent:#2b6fd6;--silver:#c9cbd4;--line-light:#cdc8bd;--radius:14px;--font:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif}.ds-dark{background:var(--ground);padding:24px 24px 24px}.ds-stairs{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;align-items:end;margin-top:110px}.ds-stairs figure{margin:0;aspect-ratio:9/14;border-radius:var(--radius);background:linear-gradient(160deg,#c4beb4,#8d8792);box-shadow:0 14px 30px -14px rgba(0,0,0,.6)}.ds-stairs figure:nth-child(2){transform:translateY(-27px)}.ds-stairs figure:nth-child(3){transform:translateY(-54px)}.ds-stairs figure:nth-child(4){transform:translateY(-81px)}.ds-stairs figure:nth-child(5){transform:translateY(-108px)}"
