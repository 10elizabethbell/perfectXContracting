      "kind": "nav",
      "refersTo": "header",
      "description": "Brand lockup left, Messenger contact right.",
      "html": "<header class=\"ds-top\"><a class=\"ds-brand\" href=\"#\"><span><b>Perfect X</b><small>Contracting</small></span></a><a class=\"ds-contact\" href=\"#\">Message us</a></header>",
      "css": ":host{--ground:#1d1932;--ground-2:#262042;--compound:#f1efe9;--ink:#1d1932;--ink-soft:#4a4466;--on-dark:#efecf7;--on-dark-soft:#bdb6d6;--violet:#6d2ee6;--violet-hi:#a678ff;--form-accent:#2b6fd6;--silver:#c9cbd4;--line-light:#cdc8bd;--radius:14px;--font:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif}.ds-top{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:var(--ground);color:var(--on-dark);font-family:var(--font)}.ds-brand{text-decoration:none;color:inherit;min-height:44px;display:flex;align-items:center}.ds-brand b{display:block;font-weight:900;font-size:15px;letter-spacing:.02em;line-height:1.05;text-transform:uppercase}.ds-brand small{display:block;font-size:11px;letter-spacing:.24em;color:var(--on-dark-soft);text-transform:uppercase}.ds-contact{min-height:44px;display:flex;align-items:center;font-weight:800;font-size:16px;text-decoration:none;color:var(--on-dark)}.ds-contact:hover{color:var(--violet-hi)}.ds-contact:focus-visible{outline:3px solid var(--violet-hi);outline-offset:3px;border-radius:6px}"
    },
    {
      "name": "Service Row",
      "kind": "custom",
      "refersTo": "service-row",
      "description": "Tappable service; on hover only the arrow fills violet.",
      "html": "<ul class=\"ds-services\"><li><a class=\"ds-row\" href=\"#\">Taping &amp; finishing<span class=\"ds-arrow\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></span></a></li></ul>",
      "css": ":host{--ground:#1d1932;--ground-2:#262042;--compound:#f1efe9;--ink:#1d1932;--ink-soft:#4a4466;--on-dark:#efecf7;--on-dark-soft:#bdb6d6;--violet:#6d2ee6;--violet-hi:#a678ff;--form-accent:#2b6fd6;--silver:#c9cbd4;--line-light:#cdc8bd;--radius:14px;--font:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif}.ds-services{list-style:none;margin:0;padding:24px;background:var(--compound)}.ds-services li{border-top:1px solid var(--line-light);border-bottom:1px solid var(--line-light)}.ds-row{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:72px;padding:10px 0;text-decoration:none;color:var(--ink);font:800 clamp(20px,5.6vw,28px)/1.2 var(--font);letter-spacing:-.01em}.ds-row:hover,.ds-row:focus-visible{outline:none;background:none;box-shadow:none}.ds-arrow{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:#e2ded5;color:var(--ink);transition:background-color .18s,color .18s}.ds-row:hover .ds-arrow{background:var(--violet);color:#fff}.ds-row:focus-visible .ds-arrow{background:var(--violet);color:#fff;outline:3px solid var(--violet);outline-offset:3px}"
    },
    {
