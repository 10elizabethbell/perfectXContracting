      "css": ":host{--ground:#1d1932;--ground-2:#262042;--compound:#f1efe9;--ink:#1d1932;--ink-soft:#4a4466;--on-dark:#efecf7;--on-dark-soft:#bdb6d6;--violet:#6d2ee6;--violet-hi:#a678ff;--form-accent:#2b6fd6;--silver:#c9cbd4;--line-light:#cdc8bd;--radius:14px;--font:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif}.ds-dark{background:var(--ground);padding:24px}.ds-btn{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:0 24px;border-radius:12px;font:800 17px/1 var(--font);text-decoration:none;border:2px solid var(--violet);cursor:pointer;transition:background-color .18s,border-color .18s,color .18s}.ds-btn:focus-visible{outline:3px solid var(--violet-hi);outline-offset:3px}.ds-btn-line{background:transparent;color:var(--on-dark);border-color:var(--silver)}.ds-btn-line:hover{border-color:var(--violet-hi);color:#fff}"
    },
    {
